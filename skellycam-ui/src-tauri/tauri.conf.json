{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Skellycam",
  "version": "2.0.0-alpha.5",
  "identifier": "skellycam.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:7777",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Skellycam 💀📸",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "script-src 'self' 'unsafe-inline'; worker-src blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../shared/skellycam-logo/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libgl1-mesa-glx",
          "libglib2.0-0",
          "libv4l-0",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/freemocap/skellycam/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
