{
  "appId": "skellycam.app",
  "productName": "skellycam",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "skellycam_server*",
    "../shared/skellycam-logo/skellycam-favicon.ico",
    "../shared/skellycam-logo/skellycam-logo.png"
  ],
  "asar": true,
  "asarUnpack": [
    "**/skellycam_server*",
    "**/skellycam-logo.png"
  ],
  "compression": "maximum",

  "win": {
    "icon": "../shared/skellycam-logo/skellycam-favicon.ico",
    "target": "nsis",
    "artifactName": "${productName}_${version}_installer.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "language": "1033"
  },

  "mac": {
    "icon": "../shared/skellycam-logo/skellycam-logo.png",
    "category": "public.app-category.video",
    "target": ["dmg", "zip"],
    "artifactName": "${productName}_${version}_${arch}_installer.${ext}",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },

  "linux": {
    "icon": "../shared/skellycam-logo/skellycam-logo.png",
    "category": "Video",
    "target": ["AppImage", "deb"],
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "desktop": {
      "Name": "SkellyCam",
      "Comment": "Camera backend for FreeMoCap",
      "Categories": "Video;AudioVideo;"
    }
  },
  "deb": {
    "depends": [
      "libgl1-mesa-glx",
      "libglib2.0-0",
      "libsm6",
      "libxext6",
      "libxrender1",
      "libv4l-0"
    ]
  },

  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://github.com/freemocap/freemocap"
  }
}
