{
  "appId": "skellycam.app",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "skellycam_server*",
    "../shared/skellycam-logo/skellycam-favicon.ico",
    "../shared/skellycam-logo/skellycam-logo.png"
  ],
  "asar": true,
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "artifactName": "${productName}_${version}_installer_${arch}.${ext}",
    "icon": "../shared/skellycam-logo/skellycam-icon.icns",
    "asarUnpack": ["**/skellycam_server", "**/skellycam-logo.png"]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}_installer.${ext}",
    "icon": "../shared/skellycam-logo/skellycam-favicon.ico",
    "asarUnpack": ["**/skellycam_server.exe", "**/skellycam-logo.png"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://github.com/freemocap/freemocap"
  }
}
