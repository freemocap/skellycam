{
  "appId": "skellycam.app",
  "productName": "skellycam",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist-electron",
    "dist",
    "skellycam_server*"
  ],
  "asar": true,
  "asarUnpack": [
    "**/skellycam_server*",
    "**/skellycam-logo.png"
  ],
  "compression": "maximum",
  "extraResources": [
    {
      "from": "build/skellycam-logo.png",
      "to": "skellycam-logo.png"
    }
  ],

  "win": {
    "icon": "build/skellycam-favicon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}_${version}_installer.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "language": "1033"
  },

  "mac": {
    "icon": "build/skellycam-logo.png",
    "category": "public.app-category.video",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}_${version}_${arch}_installer.${ext}",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },

  "linux": {
    "icon": "build/skellycam-logo.png",
    "category": "Video",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "deb",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}_${version}_${arch}.${ext}",
    "desktop": {
      "Name": "SkellyCam",
      "Comment": "Camera backend for FreeMoCap",
      "Categories": "Video;AudioVideo;"
    }
  },
  "deb": {
    "depends": [
      "libgl1-mesa-glx",
      "libglib2.0-0",
      "libsm6",
      "libxext6",
      "libxrender1",
      "libv4l-0"
    ]
  },

  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://github.com/freemocap/freemocap"
  }
}
