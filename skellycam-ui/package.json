{
  "name": "skellycam",
  "version": "2.0.0-alpha.5",
  "main": "dist-electron/main/index.js",
  "description": "SkellyCam - the camera backend for the FreeMoCap software.",
  "author": "Skelly FreeMocap <info@freemocap.org>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/freemocap/skellycam",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "tsc && vite build && electron-builder",
    "build:dev": "tsc && vite build && electron-builder --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "preview": "vite preview",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "@trpc/client": "^11.5.1",
    "@trpc/server": "^11.5.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.14",
    "d3": "^7.9.0",
    "electron-updater": "^6.1.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-grid-layout": "^2.2.2",
    "react-i18next": "^16.5.4",
    "react-redux": "^9.1.2",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.2",
    "superjson": "^2.2.2",
    "tree-kill": "^1.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@rollup/rollup-win32-x64-msvc": "^4.60.4",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^35.0.3",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
