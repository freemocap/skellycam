{
  "name": "skellycam",
  "version": "2.0.0-alpha.5",
  "description": "SkellyCam - the camera backend for the FreeMoCap software.",
  "author": "Skelly FreeMocap <info@freemocap.org>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/freemocap/skellycam",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:electron": "cross-env NODE_ENV=development vite",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:electron": "tsc && vite build && electron-builder",
    "build:electron:dev": "tsc && vite build && electron-builder --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/roboto": "^5.1.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.1.1",
    "@mui/x-tree-view": "^7.29.1",
    "@reduxjs/toolkit": "^2.5.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-app": "^2.0.0-alpha.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@trpc/client": "^11.5.1",
    "@trpc/server": "^11.5.1",
    "country-flag-icons": "^1.6.14",
    "d3": "^7.9.0",
    "electron-updater": "^6.1.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-grid-layout": "^2.2.2",
    "react-i18next": "^16.5.4",
    "react-redux": "^9.1.2",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.26.2",
    "superjson": "^2.2.2",
    "tree-kill": "^1.2.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@redux-devtools/cli": "^5.0.0",
    "@redux-devtools/remote": "^1.0.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^35.0.3",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "react": "^19.1.0",
    "react-devtools": "^6.1.5",
    "react-devtools-core": "^6.1.5",
    "react-dom": "^19.1.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
