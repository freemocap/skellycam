namespace SharedData;

table CameraFrame {
    camera_id: uint32;
    timestamp: uint64;
    frame_number: uint32;
    width: uint32;
    height: uint32;
    channels: uint32 = 3;  // RGB = 3, RGBA = 4
    pixels: [ubyte];  // Raw RGB/RGBA bytes (width * height * channels)
}

table SystemStatus {
    fps: float;
    cpu_usage: float;
    active_cameras: uint32;
    message: string;
}

table SharedMessage {
    magic: uint32 = 0xDEADBEEF;
    sequence: uint64;
    frame: CameraFrame;
    status: SystemStatus;
}

root_type SharedMessage;